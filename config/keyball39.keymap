#define LAYER_BASE 0
#define LAYER_NAV 1
#define LAYER_GAMING 2
#define LAYER_GAMING_SHFT 3
#define LAYER_GAMING_NAV 4
#define LAYER_FUNC 5
#define LAYER_POINTER 6
#define LAYER_SCROLL 7
#define LAYER_SNIPE 8

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "secrets.dtsi"

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q            &kp W       &kp E        &kp R              &kp T                                          &kp Y              &kp U            &kp I               &kp O             &kp P
&mt LALT A       &kp S       &kp D        &kp F              &kp G                                          &kp H              &kp J            &kp K               &kp L             &kp SQT
&mt LCTRL Z      &kp X       &kp C        &kp V              &kp B                                          &kp N              &mt LCTRL M      &mt LSFT COMMA      &mt LALT DOT      &kp SLASH
&kp LCTRL        &mo 6       &mo 7        &mt LGUI ESC       &kp LSFT       &lt 1 TAB         &lt 5 BSPC    &lt 1 SPACE        &mo 6
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&kp GRAVE        &kp BSLH    &kp LBKT     &kp RBKT           &kp ESC                                        &kp DEL            &kp HOME         &kp UP              &kp END           &kp BSPC
&mt LALT N1      &kp N2      &kp N3       &kp N4             &kp N5                                         &kp MINUS          &kp LEFT         &kp DOWN            &kp RIGHT         &kp SEMI
&mt LCTRL N6     &kp N7      &kp N8       &kp N9             &kp N0                                         &kp EQUAL          &kp PG_UP        &kp PG_DN           &kp LCTRL         &kp ENTER
&trans           &trans      &trans       &trans             &trans         &trans            &trans        &trans             &trans
            >;
        };

        gaming_layer {
            label = "GAMING";
            bindings = <
&kp Q            &kp W       &kp E        &kp R              &kp T                                          &kp Y              &kp U            &kp I               &kp O             &kp P
&kp A            &kp S       &kp D        &kp F              &kp G                                          &kp H              &kp J            &kp K               &kp L             &kp SQT
&kp Z            &kp X       &kp C        &kp V              &kp B                                          &kp N              &kp M            &kp COMMA           &kp DOT           &kp SLASH
&kp LCTRL        &mo 6       &kp TAB      &mo 4              &kp LSFT       &kp SPACE         &lt 5 BSPC   &lt 4 SPACE        &kp ENTER
            >;
        };

        gaming_shft_layer {
            label = "GAMING_SHFT";
            bindings = <
&kp TAB          &kp Q       &kp W        &kp E              &kp R                                          &kp Y              &kp U            &kp I               &kp O             &kp P
&kp LSFT         &kp A       &kp S        &kp D              &kp F                                          &kp H              &kp J            &kp K               &kp L             &kp SQT
&kp LCTRL        &kp Z       &kp X        &kp C              &kp V                                          &kp N              &kp M            &kp COMMA           &kp DOT           &kp SLASH
&kp LALT         &mo 6       &kp T        &mo 4              &kp SPACE      &kp G             &lt 5 BSPC   &lt 4 SPACE        &kp ENTER
            >;
        };

        gaming_nav_layer {
            label = "GAMING_NAV";
            bindings = <
&kp GRAVE        &kp BSLH    &kp LBKT     &kp RBKT           &kp ESC                                        &kp DEL            &kp HOME         &kp UP              &kp END           &kp BSPC
&kp N1           &kp N2      &kp N3       &kp N4             &kp N5                                         &kp MINUS          &kp LEFT         &kp DOWN            &kp RIGHT         &kp SEMI
&kp N6           &kp N7      &kp N8       &kp N9             &kp N0                                         &kp EQUAL          &kp PG_UP        &kp PG_DN           &kp LCTRL         &kp ENTER
&trans           &kp LALT    &kp ESC      &trans             &trans         &trans            &trans        &trans             &kp ENTER
            >;
        };

        func_layer {
            label = "FUNC";
            bindings = <
&kp F1           &kp F2      &kp F3       &kp F4             &kp F5                                         &kp C_VOL_UP       &none            &none               &none             &perspass
&kp F6           &kp F7      &kp F8       &kp F9             &kp F10                                        &kp C_VOL_DN       &none            &none               &none             &bwpass
&kp PSCRN        &none       &none        &kp F11            &kp F12                                        &kp C_MUTE         &kp C_PREV       &kp C_PP            &kp C_NEXT        &workpass
&trans           &trans      &trans       &trans             &trans         &trans            &trans        &trans             &mo 6
            >;
        };

        pointer_layer {
            label = "POINTER";
            bindings = <
&tog 2           &none       &trans       &none              &none                                          &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2        &bt BT_SEL 3      &bt BT_SEL 4
&tog 3           &none       &none        &none              &none                                          &none              &out OUT_TOG     &kp LCTRL           &none             &bt BT_CLR
&none            &kp LGUI    &kp LALT     &kp LSFT           &none                                          &mkp MB3           &mkp LCLK        &mkp RCLK           &mo 7             &none
&kp LCTRL        &trans      &trans       &mkp RCLK          &mkp LCLK      &mkp MB3          &kp LCTRL     &kp LSFT           &mo 8
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans         &trans            &trans        &trans             &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans                                         &trans             &trans           &trans              &trans            &trans
&trans           &trans      &trans       &trans             &trans         &trans            &trans        &trans             &trans
            >;
        };
    };
};
